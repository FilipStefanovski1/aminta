# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Creem (billing) — kept temporarily as rollback while checkout moves to
# AgentaOS below. The webhook route and columns still work if these are set.
CREEM_API_KEY=
CREEM_PRODUCT_ID=
CREEM_WEBHOOK_SECRET=

# AgentaOS (billing) — canonical checkout provider. API key and webhook
# secret are real secrets, configured outside git (Vercel env vars only).
# The two link ids are public product identifiers, not secrets.
AGENTAOS_API_KEY=
AGENTAOS_PRO_LINK_ID=46e8753f-deb0-4cee-bd0b-7af7d572e130
AGENTAOS_FOUNDER_LINK_ID=544e4870-b71c-46e9-93d2-bdea9fd474c7
AGENTAOS_WEBHOOK_SECRET=

# Included AI (server-side only — never exposed to the extension or any client)
GEMINI_API_KEY=
# Context enrichment (lib/ai/contextEnrichment.ts) — reuses GEMINI_API_KEY
# above via Gemini's built-in Google Search grounding tool, no separate
# provider/key. Defaults OFF (unset or anything other than "true"): this has
# not been exercised against a live Gemini response from a dev environment,
# so it's an explicit opt-in until manually verified. Set to "true" only
# after confirming one real tweet-mode generation with a named entity
# ("Solana Summit Serbia") produces sane VERIFIED CONTEXT and doesn't error.
CONTEXT_RESEARCH_ENABLED=
CRON_SECRET=
# HMAC salt for hashing client IPs before they're used as rate-limit keys or
# stored in ai_usage_log — required for per-IP rate limiting to activate; if
# unset, hashedClientIp() returns null and that layer is silently skipped
# rather than ever falling back to a raw IP. Generate with:
#   openssl rand -hex 32
IP_HASH_SALT=

# Chrome extension
NEXT_PUBLIC_AMINTA_EXTENSION_IDS=

# Internal admin dashboard (/admin) — comma-separated emails allowed in.
# Everyone else (including other signed-in users) gets redirected to "/".
ADMIN_EMAILS=

# PostHog
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=
